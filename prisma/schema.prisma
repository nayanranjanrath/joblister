// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model users {
  id               String             @id @default(uuid())
  username         String             @unique
  fullname         String?
  email            String             @unique
  password         String
  refreshtoken     String?
  dob              DateTime?
  avatar           String?
  jobs             jobs[]             @relation("postedby")
  description      String
  createdAt        DateTime           @default(now())
  appliedto        aplication[]
  educationdetails educationdetails[]
  skills           userskills[]
  posts            posts[]
  like             like[]
  comment          comment[]
}

model jobs {
  id          String        @id @default(uuid())
  post        String?
  description String?
  companyname String
  location    String
  type        String
  createdAt   DateTime      @default(now())
  expaireAT   DateTime
  postedbyid  String
  requirment  requirement[]
  postedby    users         @relation("postedby", fields: [postedbyid], references: [id])
  application aplication[]
}

model aplication {
  id        String            @id @default(uuid())
  jobid     String            @unique
  userid    String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  job       jobs              @relation(fields: [jobid], references: [id])
  user      users             @relation(fields: [userid], references: [id])

  @@unique([jobid, userid])
}

model educationdetails {
  id               String       @id @default(uuid())
  userid           String
  degree           String
  yearofcomplition DateTime
  college          String
  proof            String
  user             users        @relation(fields: [userid], references: [id])
  userskills       userskills[]
}

model expirience {
  id      String   @id @default(uuid())
  start   DateTime
  end     DateTime @default(now())
  details String
  proof   String
  company String

  userskills userskills[]
}

model requirement {
  id          String   @id @default(uuid())
  skillids      String[] @default([])
  expirience  Int
  description String
  jobid       String   @unique
  job         jobs     @relation(fields: [jobid], references: [id])
  skills      skills  @relation(fields: [skillids],references: [id])
}

model skills {
  id    String @id @default(uuid())
  skill String

  userskills userskills[]
}

model userskills {
  id               String            @id @default(uuid())
  skillid          String
  userid           String
  educationid      String?
  expirienceid     String?
  educationdetails educationdetails? @relation(fields: [educationid], references: [id])
  expirience       expirience?       @relation(fields: [expirienceid], references: [id])
  user             users             @relation(fields: [userid], references: [id])
  skill            skills            @relation(fields: [skillid], references: [id])
}

model posts {
  id          String    @id @default(uuid())
  title       String
  post        String?
  description String
  createdAt   DateTime  @default(now())
  postedbyid  String
  postedby    users     @relation(fields: [postedbyid], references: [id])
  like        like[]
  comment     comment[]
}

model like {
  id     String @id @default(uuid())
  userid String
  postid String
  user   users  @relation(fields: [userid], references: [id])
  post   posts  @relation(fields: [postid], references: [id])

  @@unique([postid, userid])
}

model comment {
  id      String @id @default(uuid())
  comment String
  userid  String
  postid  String
  user    users  @relation(fields: [userid], references: [id])
  post    posts  @relation(fields: [postid], references: [id])
}
