generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  
}
model users{
  id    String @id @default(uuid())
  username   String @unique
  fullname   String?
  email String @unique
password String
  refreshtoken String?
  dob   DateTime?
  avatar String?
  jobs jobs[]@relation("postedby")
  description String
  createdAt DateTime @default(now())
  appliedto aplication[]
  educationdetails educationdetails[]
}

model jobs {
  id String @id @default(uuid())
  post String
  description String?
  companyname String
  location String
  type String
  createdAt DateTime @default(now())
  expaireAT DateTime 
  postedbyid String
  postedby users @relation("postedby",fields: [postedbyid],references: [id])
  aplicatn aplication[]
}

model aplication {
  id String @id @default(uuid())
  jobid String
  userid String
  status ApplicationStatus @default(PENDING) 
  createdAt DateTime @default(now())
  job jobs @relation(fields: [jobid],references: [id])
  user users @relation(fields: [userid],references: [id])
  @@unique([jobid,userid])
}

model educationdetails{
  id String @id @default(uuid())
  userid String
  degree String
  yearofcomplition String
  college  String
  proof String
  user users @relation(fields: [userid],references: [id])
}
model expirience{
  id String @id @default(uuid())
  start DateTime
  end DateTime @default(now())
  details String
  proof String
  company String


}

model requirement {
  id String @id @default(uuid())
  skills String[]
  expirience Int
  description String

}
model skills{
  id String @id @default(uuid())
  skill String

}
